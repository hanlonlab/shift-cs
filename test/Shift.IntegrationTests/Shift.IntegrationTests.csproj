<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Shift.Archiver/Shift.Archiver.csproj" />
    <ProjectReference Include="../../src/Shift.Engine/Shift.Engine.csproj" />
    <ProjectReference Include="../../src/Shift.Ipc/Shift.Ipc.csproj" />
    <ProjectReference Include="../../src/Shift.Protocol/Shift.Protocol.csproj" />
    <ProjectReference Include="../../src/Shift.ReferenceFeed/Shift.ReferenceFeed.csproj" />
    <ProjectReference Include="../../src/Shift.Sequencer/Shift.Sequencer.csproj" />
    <ProjectReference Include="../../tools/Shift.LoadGenerator/Shift.LoadGenerator.csproj" />
  </ItemGroup>
</Project>
